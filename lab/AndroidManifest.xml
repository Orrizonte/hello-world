<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="fr.externalscreen.beastlab"
          android:versionCode="9" android:versionName="1.8">
    <uses-feature android:name="android.hardware.usb.host" android:required="false"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application android:label="Beast Lab"
                 android:icon="@android:drawable/ic_menu_manage"
                 android:theme="@android:style/Theme.Material.NoActionBar"
                 android:extractNativeLibs="true"
                 android:allowBackup="false">
        <activity android:name=".LabActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".DepthService" android:exported="false"
                 android:foregroundServiceType="mediaProjection"/>
    </application>
</manifest>
